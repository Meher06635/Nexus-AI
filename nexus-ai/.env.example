# Copy to .env and adjust paths for your machine.

# Ollama — pick a model that fits FREE RAM (not total RAM). Mistral often needs ~5–8 GB.
OLLAMA_BASE_URL=http://localhost:11434
# Default in Nexus (~2–4 GB free): pull once with `ollama pull llama3.2:1b`
OLLAMA_MODEL=llama3.2:1b
# If you have plenty of memory:
# OLLAMA_MODEL=mistral:latest
# Even lighter (~1 GB):
# OLLAMA_MODEL=tinyllama

# Whisper: tiny uses least RAM/VRAM alongside Ollama; base is a balanced default.
WHISPER_MODEL=tiny

# SQLite database file (default: backend/database/nexus.db inside project)
# DATABASE_PATH=C:/path/to/nexus.db

# Optional directories (defaults under project root)
# SCREENSHOTS_DIR=
# LOGS_DIR=
# NOTES_DIR=

# Playwright: use installed Chrome/Edge or leave blank for bundled Chromium
PLAYWRIGHT_HEADLESS=false
DEFAULT_BROWSER_CHANNEL=chrome

# Voice features
ENABLE_VOICE_STT=true
ENABLE_VOICE_TTS=true
# Speak an automatic completion acknowledgment after successful command execution
AUTO_VOICE_TASK_COMPLETION=true
